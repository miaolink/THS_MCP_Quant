{
  "server": "rhths-trade",
  "transport": "stdio",
  "gateway_env": "RHTHS_GATEWAY_URL",
  "gateway_default": "http://127.0.0.1:19312",
  "live_env": "RHTHS_ALLOW_LIVE",
  "live_default": "0",
  "tools": [
    {"name": "rh_trade_health", "category": "system", "readonly": true},
    {"name": "rh_trade_catalog", "category": "system", "readonly": true},
    {"name": "rh_trade_mode_get", "category": "trade", "readonly": true},
    {"name": "rh_trade_mode_set", "category": "trade", "params": {"mode": "simulate|live", "dry_run": "bool?"}},
    {"name": "rh_trade_users", "category": "trade", "readonly": true, "params": {"user": "string?", "rzrq": "bool?"}},
    {"name": "rh_trade_account", "category": "trade", "readonly": true, "params": {"user": "string?", "rzrq": "bool?"}},
    {"name": "rh_trade_positions", "category": "trade", "readonly": true, "params": {"user": "string?", "rzrq": "bool?"}},
    {"name": "rh_trade_orders_today", "category": "trade", "readonly": true, "params": {"user": "string?", "rzrq": "bool?"}},
    {"name": "rh_trade_orders_history", "category": "trade", "readonly": true, "params": {"start_date": "YYYYMMDD?", "end_date": "YYYYMMDD?", "code": "string?", "exclude_today": "bool?"}},
    {"name": "rh_trade_warmup", "category": "trade", "readonly": true},
    {"name": "rh_trade_buy", "category": "trade", "write": true, "params": {"code": "string", "qty": "int", "price": "string?", "dry_run": "bool?", "confirm_live": "bool?"}},
    {"name": "rh_trade_sell", "category": "trade", "write": true, "params": {"code": "string", "qty": "int", "price": "string?", "dry_run": "bool?"}},
    {"name": "rh_trade_cancel", "category": "trade", "write": true, "params": {"htbh": "string?", "scope": "string?", "dry_run": "bool?"}},
    {"name": "rh_trade_invoke", "category": "trade", "write": true, "params": {"cmd": "string", "dry_run": "bool?"}},
    {"name": "rh_market_quote", "category": "market", "readonly": true, "params": {"code": "string"}},
    {"name": "rh_market_price", "category": "market", "readonly": true, "params": {"codes": "string[]"}},
    {"name": "rh_market_kline", "category": "market", "readonly": true},
    {"name": "rh_market_kline_sec", "category": "market", "readonly": true},
    {"name": "rh_market_wencai", "category": "market", "readonly": true},
    {"name": "rh_market_select_stocklist", "category": "market", "readonly": true},
    {"name": "rh_market_reg_quote", "category": "market", "readonly": true},
    {"name": "rh_market_reg_kline", "category": "market", "readonly": true},
    {"name": "rh_market_wait_update", "category": "market", "readonly": true},
    {"name": "rh_market_unreg_quote", "category": "market", "readonly": true},
    {"name": "rh_market_unreg_kline", "category": "market", "readonly": true},
    {"name": "rh_indicator_list", "category": "indicator", "readonly": true},
    {"name": "rh_indicator_calc", "category": "indicator", "readonly": true, "params": {"code": "string", "name": "string"}}
  ]
}
